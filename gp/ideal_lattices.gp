\\ ideal_lattices.gp -- ideal lattices over a CM field L, PARI/GP >= 2.13
\\
\\ An ideal lattice is (I, alpha): I a fractional ideal of L, alpha in L^+ totally
\\ positive, with the Z-bilinear form  b(x,y) = Tr_{L/Q}(alpha * x * conj(y)).
\\ Its Z-dual is  I^# = (alpha * conj(I) * Diff_L)^(-1).   Hence
\\      I^# = c^(-1) I   <=>   alpha * I * conj(I) * Diff_L = (c).
\\ c = 1         : unimodular
\\ c = sqrt(-l)  : l-modular (multiplication by sqrt(-l) is the similarity)
\\ c = sqrt(-d)  : "Hermitian unimodular over O_K", K = Q(sqrt(-d)) inside L
\\
\\ Everything is done with polmods modulo L.pol so that it stays readable.

\\ complex conjugation of the CM field as a polmod (image of the generator)
cm_conj(nf) =
{ my(P = nf.pol, v = variable(P), r = nf.roots[1], a = nfgaloisconj(nf));
  for (i = 1, #a,
    if (abs(subst(a[i], v, r) - conj(r)) < 1e-15 * (1 + abs(r)), return (Mod(a[i], P))));
  error("no complex conjugation found: field is not Galois/CM?");
}
cj(y, s) = subst(lift(y), variable(s.mod), s);

\\ sign pattern (1 = negative) of a totally real element at the r2 places
sgnvec(nf, y) =
{ my(v = variable(nf.pol), r = nf.roots);
  vectorv(#r, i, real(subst(lift(y), v, r[i])) < 0);
}

\\ real units of L (as polmods), generating E^+ modulo squares: -1, and for the
\\ fundamental units eps_j with eps_j/conj(eps_j) = zeta^(a_j):
\\   a_j even -> zeta^k eps_j is real for a suitable k;
\\   a_j odd  -> (Hasse unit index 2) pair it with a fixed odd eps_0.
mkreal(u, z, w, s) =
{ for (k = 0, w - 1, if (cj(z^k * u, s) == z^k * u, return (z^k * u)));
  0;
}
real_units(bnf, s) =
{ my(nf = bnf.nf, w = bnf.tu[1], z = Mod(lift(bnf.tu[2]), nf.pol), R = List([Mod(-1, nf.pol)]),
     fu = apply(u -> Mod(lift(u), nf.pol), bnf.fu), odd = 0, u, ok);
  for (j = 1, #fu,
    u = mkreal(fu[j], z, w, s);
    if (u != 0, listput(R, u); next);
    if (odd == 0, odd = fu[j]; listput(R, mkreal(odd^2, z, w, s)); next);
    listput(R, mkreal(odd * fu[j], z, w, s)));
  Vec(R);
}

\\ All totally positive real generators (mod squares of real units) of the
\\ principal ideal generated by g; returns a vector (possibly empty).
totpos_gens(bnf, s, g, RU, maxsol = 8) =
{ my(nf = bnf.nf, w = bnf.tu[1], z = Mod(lift(bnf.tu[2]), nf.pol), a = 0, u, M, b, X, K, out = List(), y);
  for (j = 0, #bnf.fu,
    for (k = 0, w - 1,
      u = z^k * if (j, Mod(lift(bnf.fu[j]), nf.pol), 1);
      if (cj(u * g, s) == u * g, a = u * g; break(2))));
  if (a == 0, return ([]));
  M = matconcat(vector(#RU, i, sgnvec(nf, RU[i])));
  b = sgnvec(nf, a);
  X = matsolvemod(M, 2, b, 1);
  if (X == 0, return ([]));
  K = X[2]; X = X[1];
  \\ K: lattice of solutions of M*X = 0 mod 2 ; only its image mod 2 matters
  K = matimagemod(K, 2);
  if (#K == 0, return ([a * prod(i = 1, #RU, RU[i]^X[i])]));
  forvec (e = vector(#K, i, [0, 1]),
    y = (X + K * e~) % 2;
    listput(out, a * prod(i = 1, #RU, RU[i]^y[i]));
    if (#out >= maxsol, break));
  Vec(out);
}

\\ Gram matrix of (I, alpha) on the HNF Z-basis of I, and the matrix of
\\ multiplication by each element of the vector `ops` on that basis.
ideal_gram(nf, s, Id, alpha, ops = []) =
{ my(n = poldegree(nf.pol), M = idealhnf(nf, Id), B, C, G, Mi, J);
  B = vector(n, i, nfbasistoalg(nf, M[, i]));
  C = vector(n, i, alpha * cj(B[i], s));
  G = matrix(n, n, i, j, if (j >= i, trace(B[i] * C[j]), 0));
  for (i = 1, n, for (j = 1, i - 1, G[i, j] = G[j, i]));
  Mi = M^(-1);
  J = vector(#ops, t, Mi * matconcat(vector(n, i, nfalgtobasis(nf, ops[t] * B[i]))));
  [G, J];
}

\\ Enumerate every ideal class.  Returns a vector of [e, alpha, G, Jvec].
\\ c : element of L (polmod) or ideal;  ops : elements whose action is wanted.
ideal_lattices(bnf, c, ops = [], maxsol = 8, verbose = 0) =
{ my(nf = bnf.nf, s = cm_conj(nf), cyc = bnf.cyc, gen = bnf.gen, D = nf.diff, RU = real_units(bnf, s),
     out = List(), Id, A, t, al, r, cid);
  cid = idealhnf(nf, c);
  forvec (e = vector(#cyc, i, [0, cyc[i] - 1]),
    Id = idealhnf(nf, 1);
    for (i = 1, #cyc, if (e[i], Id = idealmul(nf, Id, idealpow(nf, gen[i], e[i]))));
    Id = idealred(nf, Id);
    A = idealdiv(nf, cid, idealmul(nf, idealmul(nf, Id, nfgaloisapply(nf, lift(s), Id)), D));
    t = bnfisprincipal(bnf, A);
    if (t[1] != 0, next);
    al = totpos_gens(bnf, s, nfbasistoalg(nf, t[2]), RU, maxsol);
    for (k = 1, #al,
      r = ideal_gram(nf, s, Id, al[k], ops);
      listput(out, [e, al[k], r[1], r[2]]);
      if (verbose, print("class ", e, " sol ", k))));
  Vec(out);
}

\\ Twisting: if (I, alpha) solves alpha*I*conj(I)*Diff = (c) then so does
\\ (I * Q / conj(Q), alpha) for EVERY ideal Q.  This samples the family without
\\ any class-group computation (needs only nfinit), which is what makes
\\ degree 84 / 96 fields accessible.
twist(nf, s, Id, Q) = idealmul(nf, Id, idealdiv(nf, Q, nfgaloisapply(nf, lift(s), Q)));

\\ LLL-reduce a Gram matrix, carrying operators along
lllred(G, J = []) =
{ my(U = qflllgram(G, 1));
  [U~ * G * U, vector(#J, i, U^(-1) * J[i] * U)];
}
\\ number of vectors of norm <= B (pairs counted twice), and the minimum
nshort(G, B) = qfminim(G, B, 0)[1];

\\ Kronecker product
kron(A, B) =
{ my(ra = matsize(A)[1], ca = matsize(A)[2], rb = matsize(B)[1], cb = matsize(B)[2]);
  matrix(ra * rb, ca * cb, i, j, A[(i - 1) \ rb + 1, (j - 1) \ cb + 1] * B[(i - 1) % rb + 1, (j - 1) % cb + 1]);
}
