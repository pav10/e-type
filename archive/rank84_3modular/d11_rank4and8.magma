[ -2*w + 44,   4*w - 22,  -6*w - 22,   5*w - 11,         44,       12*w,  -9*w - 33,       12*w],
[-14*w - 22,   8*w + 22,  10*w - 22,   3*w + 11,      -12*w,         44,  15*w - 33,  -3*w + 33],
