/*** vartheta-lattices over K = Q(sqrt-11), OK = Z[(1+sqrt-11)/2] ***/
/*** COMPLETE: rank 4 (1 lattice) + rank 8 (6 lattices). Hentschel ***/
S<w>:=QuadraticField(-11);

GramRank4:=1/11*Matrix(S,[
[  22,    0,  6*w,  2*w],
[   0,   22,  2*w, -6*w],
[-6*w, -2*w,   22,    0],
[-2*w,  6*w,    0,   22]]);

Gram1:=1/11*Matrix(S,[
[        44,          0,        6*w,        4*w,  -2*w + 22,   6*w + 22,        -22,  11*w + 11],
[         0,         22,        2*w,    -w + 11,          0,          0,          0,          0],
[      -6*w,       -2*w,         22,          0,          0,          0,          0,          0],
[      -4*w,     w + 11,          0,         22,  -5*w - 11,  -3*w + 11,          0,         22],
[  2*w + 22,          0,          0,   5*w - 11,         44,   8*w + 22,   4*w - 22,       12*w],
[ -6*w + 22,          0,          0,   3*w + 11,  -8*w + 22,         44,   8*w - 22,   8*w + 44],
[       -22,          0,          0,          0,  -4*w - 22,  -8*w - 22,         44, -11*w - 11],
[-11*w + 11,          0,          0,         22,      -12*w,  -8*w + 44,  11*w - 11,         66]]);

Gram2:=1/11*Matrix(S,[
[       132,         66, -10*w - 22,        4*w,   2*w + 44,  14*w - 22, -33*w - 33,  22*w + 22],
