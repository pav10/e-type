[ 10*w - 22,   7*w - 11,         22,          0,   3*w - 11,  -5*w - 11,         44,        -22],
[      -4*w,     w + 11,          0,         22,  -5*w - 11,  -3*w + 11,          0,         22],
[ -2*w + 44,  -4*w + 22,  -3*w - 11,   5*w - 11,         44,       12*w,  -9*w - 33,       12*w],
[-14*w - 22,  -8*w - 22,   5*w - 11,   3*w + 11,      -12*w,         44,  15*w - 33,  -3*w + 33],
[ 33*w - 33,  22*w - 22,         44,          0,   9*w - 33, -15*w - 33,        132,        -66],
[-22*w + 22, -11*w + 11,        -22,         22,      -12*w,   3*w + 33,        -66,         66]]);

Gram3:=1/11*Matrix(S,[
