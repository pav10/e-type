// ====================================================================
// rank84_coulangeon.magma
// Hermitian-tensor candidate for an extremal 3-modular lattice, rank 84,
// with minimum certification via Coulangeon's bound (1201.1832 Prop 3.3/5.2)
// instead of brute-force theta enumeration.
//
// BRICKS (DO NOT rebuild -- import from Nebe's Catalogue of Lattices and
//   Hentschel's rank-12 Eisenstein dataset):
//     A = K12  (Coxeter-Todd) : Hermitian rank 6 over Z[w], 3-modular brick
//     B = [+-G2(3)]_14 lattice : Hermitian rank 7 over Z[w]
//   6 * 7 = 42  ->  trace lattice Z-rank 84, det 3^42 (3-modular).
//
// CERTIFICATION (the point):
//   For z in A (x) B of rank r:   h(z,z) >= r * dr(A)^{1/r} * dr(B)^{1/r}.
//   Need this >= (extremal Hermitian min) for ALL r = 1..6.
//   Euclidean min of Z[w] is mu = 1/3, so Prop 3.5 gives d2 >= (2/3) m^2,
//   and the rank-r minimal determinants dr(A), dr(B) come from the
//   *classified* bricks (look up / compute once with Voronoi).
// ====================================================================

// ---- Eisenstein order ----
K<w> := QuadraticField(-3);
ZK := MaximalOrder(K);
mu := 1/3;                       // Euclidean minimum of Z[w]

// ---- IMPORT bricks here (placeholders; replace Gram entries) ----
// Hermitian Gram matrices over ZK.  Fill from the catalogue.
// A := HermitianForm K12 ...
// B := HermitianForm G2(3) ...

// ---- Coulangeon lower bound for tensor minimum ----
// dseq_A, dseq_B : sequences [d1, d2, ..., dm] of minimal determinants
//                  (Hermitian) of the two factors, indexed by rank.
function CoulangeonMinBound(dseq_A, dseq_B)
    m := Min(#dseq_A, #dseq_B);
    lb := Infinity();
    for r in [1..m] do
        // h(z,z) >= r * dr(A)^(1/r) * dr(B)^(1/r)
        val := r * (Real(dseq_A[r])^(1/r)) * (Real(dseq_B[r])^(1/r));
        if val lt lb then lb := val; rmin := r; end if;
    end for;
    return lb, rmin;
end function;

// ---- Extremal Hermitian minimum target for rank-84 3-modular ----
// Z-minimum 16 => Hermitian minimum d1 = 16/2 = 8 (trace form doubles).
TARGET_HERM_MIN := 8;

// ---- Certification driver ----
procedure Certify(dseq_A, dseq_B)
    lb, r := CoulangeonMinBound(dseq_A, dseq_B);
    printf "Coulangeon bound: min Hermitian norm >= %o (worst rank r=%o)\n", lb, r;
    if lb ge TARGET_HERM_MIN then
        printf "  PROVEN: minimum >= %o  =>  Z-minimum >= %o  (EXTREMAL)\n",
               TARGET_HERM_MIN, 2*TARGET_HERM_MIN;
    else
        printf "  NOT proven by bound alone at rank %o.\n", r;
        printf "  -> need the equality analysis (Prop 3.3 last clause):\n";
        printf "     does B contain a minimal r-section ~= (A_r)^#?\n";
        printf "     This is the finite representation-number check\n";
        printf "     (cf. Thm 5.3 / Cor 5.4: 'does P_i contain P_b').\n";
    end if;
end procedure;

